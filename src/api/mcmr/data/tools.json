[
 {
  "name": "Pylint",
  "codes": "[CEFIRW]\\d{4}",
  "documentation": "https://pylint.readthedocs.io/en/stable/user_guide/messages/{category}/{symbol}.html",
  "categories": {
   "C": "convention",
   "E": "error",
   "F": "fatal",
   "I": "informational",
   "R": "refactor",
   "W": "warning"
  },
  "inventoried": true,
  "languages": ["python"]
 },
 {
  "name": "Ruff",
